ENVIRONMENT=development
LOG_LEVEL=info,sqlx=warn,async_nats=warn
LOG_FORMAT=pretty                 # pretty | json

# --- Shared Infra ---
NATS_URL=nats://localhost:4222
NATS_REQUEST_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379

# --- BDD per service ---
AUTH_DATABASE_URL=postgres://touchdown:touchdown@localhost:5433/auth_db
CATALOG_DATABASE_URL=postgres://touchdown:touchdown@localhost:5434/catalog_db
INVENTORY_DATABASE_URL=postgres://touchdown:touchdown@localhost:5435/inventory_db
MEDIA_DATABASE_URL=postgres://touchdown:touchdown@localhost:5436/media_db
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_MS=5000

# --- PASETO v4.public (generated by `make keys`) ---
PASETO_SECRET_KEY=
PASETO_PUBLIC_KEY=
PASETO_ISSUER=touchdown
PASETO_AUDIENCE=touchdown-api
PASETO_ACCESS_TTL_SECS=900
PASETO_REFRESH_TTL_SECS=2592000

# --- Objets & recherche ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=touchdown
S3_SECRET_KEY=touchdown123
S3_PUBLIC_BUCKET=touchdown-media
S3_PRIVATE_BUCKET=touchdown-private
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=touchdown_dev_master_key

# --- Gateway ---
HTTP_ADDR=0.0.0.0:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# --- OpenTelemetry ---
# OTLP_ENDPOINT=http://localhost:4317